# Base URL of the existing commerce/admin API (omit the trailing /api).
# The storefront appends /api for its requests. Leave blank until configured.
NEXT_PUBLIC_ADMIN_PANEL_URL=

# Canonical public URL used for metadata, robots.txt and generated sitemaps.
NEXT_PUBLIC_SITE_URL=

# Optional comma-separated hosts for remote product/store images.
NEXT_PUBLIC_IMAGE_HOSTS=

# Keep true for the Next.js server-rendered app. Set false only for a
# deployment intentionally configured for static export.
NEXT_PUBLIC_SSR=true

# Optional analytics IDs. No source-repository tracking IDs are included.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_MICROSOFT_CLARITY_ID=
